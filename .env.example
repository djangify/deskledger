# DeskLedger settings. Copy this file to ".env" (same folder) if you want to change anything.
# For normal local use you can skip this file completely: DeskLedger creates its own
# secret key and encryption key the first time it runs and stores them in the data/ folder.

# Keep True for local use on http://127.0.0.1. Setting False turns on HTTPS-only
# cookies and redirects, which stops the app working over plain http.
DEBUG=True

# Leave unset to use an automatically generated per-install key (recommended).
# SECRET_KEY=

# Hosts that may reach the app. Only add your LAN IP if you deliberately share it
# on your network (see README: "Sharing on your network").
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Leave unset to use an automatically generated per-install key.
# Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# First login (created the first time the app runs).
# Leave DEFAULT_USER_PASSWORD empty and a random password is generated and saved to
# data/first_login.txt. Setting your own here is allowed but not recommended.
DEFAULT_USER_EMAIL=demo@example.com
# DEFAULT_USER_PASSWORD=

# Optional email (password-reset emails). Without these, emails print to the console.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=
